# ─────────────────────────────────────────────────────────────────────────────
# MockMate - AI Agents environment variables
# Copy this file to .env and fill in your real values before running adk web.
# ─────────────────────────────────────────────────────────────────────────────

# ── Platform selection ────────────────────────────────────────────────────────
# Set TRUE to use Vertex AI (production / GCP billing account)
# Set FALSE to use Gemini AI Studio (free-tier dev key)
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# ── Vertex AI  (required when GOOGLE_GENAI_USE_VERTEXAI=TRUE) ─────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ── Gemini AI Studio (required when GOOGLE_GENAI_USE_VERTEXAI=FALSE) ──────────
# GOOGLE_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Model override (optional - defaults shown below) ─────────────────────────
# Vertex AI GA model:  gemini-live-2.5-flash-native-audio
# AI Studio dev model: gemini-2.5-flash-native-audio-preview-12-2025
# MOCKMATE_LIVE_MODEL=gemini-live-2.5-flash-native-audio
