# Copy this file to .env and fill in your values. Never commit .env to git.

# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Cloud Storage
GCS_BUCKET=mockmate-storage

# Firestore
FIRESTORE_DATABASE=(default)          # name of your Firestore database; (default) is fine unless you created a named one
FIRESTORE_RESUME_COLLECTION=resumes

# Pub/Sub
PUBSUB_TOPIC_SESSION_END=session-end

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com
