# Copy this file to .env and fill in your values. Never commit .env to git.

# Gemini models
GEMINI_MODEL=gemini-2.5-flash-lite
MOCKMATE_LIVE_MODEL=gemini-live-2.5-flash-native-audio
IMAGEN_MODEL=imagen-3.0-fast-generate-001

# ADK / Gemini Live — MUST be set for the live interview to work
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Cloud Storage
GCS_BUCKET=mockmate-storage

# Firestore
FIRESTORE_DATABASE=(default)          # name of your Firestore database; (default) is fine unless you created a named one
FIRESTORE_RESUME_COLLECTION=resumes
FIRESTORE_SESSION_COLLECTION=sessions
FIRESTORE_TRANSCRIPT_COLLECTION=transcripts

# Pub/Sub
PUBSUB_TOPIC_SESSION_END=session-end

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com
